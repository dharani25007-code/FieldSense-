# Get free keys at https://aistudio.google.com/apikey
# Add separate keys for zero-downtime round-robin load balancing
GEMINI_API_KEY_1=your_first_gemini_key
GEMINI_API_KEY_2=your_second_gemini_key
GEMINI_API_KEY_3=your_third_gemini_key

# Optional — free tier at https://openweathermap.org/api (used for the Advisory tab)
# The app still works without this; it just skips live weather context.
OPENWEATHER_API_KEY=your_openweather_key_here

PORT=8080
